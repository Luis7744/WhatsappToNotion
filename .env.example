# Puerto en el que escuchará el servidor Express
PORT=3000

# Credenciales de la API de Notion
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Credenciales de la API de WhatsApp Cloud
WHATSAPP_TOKEN=EAA...
WHATSAPP_VERIFY_TOKEN=token_verificacion_webhook
WHATSAPP_PHONE_NUMBER_ID=1234567890

# URL pública del servidor (requerido para exponer los ficheros descargados a Notion)
# Ejemplo: https://mi-dominio.com
PUBLIC_BASE_URL=

# Ruta donde se almacenarán los adjuntos descargados (opcional)
# Si se deja vacío, se utilizará storage/media dentro del proyecto
MEDIA_STORAGE_PATH=
